# =============================================
# FREELANCE DEVELOPER HARNESS CONFIGURATION
# =============================================
# Copy this to .env and fill in values
# NEVER commit .env to version control

# === STUDIO IDENTITY ===
STUDIO_NAME=Your Studio Name
STUDIO_SLUG=your-studio-slug
STUDIO_EMAIL=hello@yourstudio.com
STUDIO_TIMEZONE=America/New_York

# === SOURCE ROOT ===
# Base directory where your project source repos are checked out.
# Default: parent directory of this harness repo (sibling-repo convention).
# Example: SOURCE_ROOT_BASE=/home/yourname/projects
#   → project repos expected at /home/yourname/projects/<project-slug>/
SOURCE_ROOT_BASE=

# === ACTIVE CLIENTS ===
# Add client slugs as comma-separated list
ACTIVE_CLIENTS=

# === VERSION CONTROL ===
GITHUB_TOKEN=
DEFAULT_BRANCH=main
ORG_GITHUB_ORG=

# === PROJECT MANAGEMENT ===
# Options: linear, jira, notion, asana
PM_TOOL=linear
LINEAR_API_KEY=
LINEAR_WORKSPACE_ID=
JIRA_API_KEY=
JIRA_BASE_URL=
NOTION_TOKEN=

# === DESIGN TOOLS ===
# Options: figma, sketch, adobe-xd
DESIGN_TOOL=figma
FIGMA_TOKEN=
FIGMA_TEAM_ID=

# === COMMUNICATION ===
SLACK_BOT_TOKEN=
SLACK_CHANNEL_GENERAL=
SLACK_CHANNEL_ALERTS=

# === AI MODELS ===
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL=gemini-2.0-flash

# === DEPLOYMENT ===
# Options: vercel, netlify, aws, gcp, azure
DEFAULT_DEPLOY_TARGET=vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# === MONITORING ===
SENTRY_DSN=
DATADOG_API_KEY=

# === DEVELOPMENT ===
DEV_COMMAND=npm run dev
BUILD_COMMAND=npm run build
TEST_COMMAND=npm run test
LINT_COMMAND=npm run lint
